diff --git a/src/server/game/Handlers/QuestHandler.cpp b/src/server/game/Handlers/QuestHandler.cpp
--- a/src/server/game/Handlers/QuestHandler.cpp
+++ b/src/server/game/Handlers/QuestHandler.cpp
@@ -220,11 +220,48 @@ void WorldSession::HandleQuestGiverAcceptQuest(WorldPackets::Quest::QuestGiverAc
                 default:
                     break;
             }
-            _player->PlayerTalkClass->SendCloseGossip();
-
             if (quest->SourceSpellID)
                 _player->CastSpell(_player, quest->SourceSpellID, true);
 
+            bool sentFollowupMenu = false;
+            if (!(quest->FlagsEx & QUEST_FLAGS_EX_SUPPRESS_GOSSIP_ACCEPT))
+            {
+                if (quest->HasFlag(QUEST_FLAGS_LAUNCH_GOSSIP_ACCEPT))
+                {
+                    if (Creature* creature = object->ToCreature())
+                    {
+                        _player->PrepareGossipMenu(creature, creature->GetCreatureTemplate()->GossipMenuId, true);
+                        _player->SendPreparedGossip(creature);
+                        sentFollowupMenu = true;
+                    }
+                    else if (GameObject* gameObject = object->ToGameObject())
+                    {
+                        _player->PrepareGossipMenu(gameObject, 0, true);
+                        _player->SendPreparedGossip(gameObject);
+                        sentFollowupMenu = true;
+                    }
+                }
+                else if (object->IsCreature() || object->IsGameObject())
+                {
+                    _player->PrepareQuestMenu(object->GetGUID());
+
+                    QuestMenu const& questMenu = _player->PlayerTalkClass->GetQuestMenu();
+                    for (uint32 i = 0; i < questMenu.GetMenuItemCount(); ++i)
+                    {
+                        QuestMenuItem const& menuItem = questMenu.GetItem(i);
+                        if (menuItem.QuestId != packet.QuestID && _player->GetQuestStatus(menuItem.QuestId) == QUEST_STATUS_NONE)
+                        {
+                            _player->SendPreparedQuest(object->GetGUID());
+                            sentFollowupMenu = true;
+                            break;
+                        }
+                    }
+                }
+            }
+
+            if (!sentFollowupMenu)
+                _player->PlayerTalkClass->SendCloseGossip();
+
             return;
         }
     }
