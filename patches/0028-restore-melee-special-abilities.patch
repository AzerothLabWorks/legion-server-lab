@@ -262,13 +274,32 @@ void AggressorAI::EnterCombat(Unit* who)
     me->CastStop();
-    for (auto& spell : *me->CreatureSpells)
+
+    // The Legion archive splits ordinary creature abilities between the
+    // legacy spell1-spell8 columns and creature_template_spell. Merge both so
+    // melee fallback AI retains its full combat kit without duplicate events.
+    SpellVct spells;
+    for (uint32 spellId : me->m_templateSpells)
+        if (spellId && sSpellMgr->GetSpellInfo(spellId))
+            spells.push_back(spellId);
+
+    if (me->CreatureSpells)
+        for (CreatureSpellList::value_type const& creatureSpell : *me->CreatureSpells)
+            if (uint32 spellId = creatureSpell.second.SpellID)
+                if (sSpellMgr->GetSpellInfo(spellId)
+                    && std::find(spells.begin(), spells.end(), spellId) == spells.end())
+                    spells.push_back(spellId);
+
+    for (uint32 spellId : spells)
     {
-        if (AISpellInfo[spell.second.SpellID].condition == AICOND_AGGRO)
+        if (AISpellInfo[spellId].condition == AICOND_AGGRO)
         {
-            if (SpellInfo const* sInfo = sSpellMgr->GetSpellInfo(spell.second.SpellID))
+            if (SpellInfo const* sInfo = sSpellMgr->GetSpellInfo(spellId))
                 if (sInfo->CanAutoCast(me, who))
-                    me->CastSpell(who, spell.second.SpellID, false);
+                    me->CastSpell(who, spellId, false);
+        }
+        else if (AISpellInfo[spellId].condition == AICOND_COMBAT)
+        {
+            uint32 cooldown = std::max<uint32>(AISpellInfo[spellId].cooldown, 5000);
+            spellCasts.ScheduleEvent(spellId, cooldown + urand(0, cooldown));
         }
-        else if (AISpellInfo[spell.second.SpellID].condition == AICOND_COMBAT)
-            spellCasts.ScheduleEvent(spell.second.SpellID, AISpellInfo[spell.second.SpellID].cooldown + rand() % AISpellInfo[spell.second.SpellID].cooldown);
     }
     if (me->m_CanCallAssistance)
