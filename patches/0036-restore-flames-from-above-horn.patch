+class item_tholos_horn : public ItemScript
+{
+public:
+    item_tholos_horn() : ItemScript("item_tholos_horn") { }
+
+    bool OnUse(Player* player, Item* item, SpellCastTargets const& /*targets*/) override
+    {
+        if (item->GetEntry() != 55122 ||
+            player->GetQuestStatus(25574) != QUEST_STATUS_INCOMPLETE ||
+            player->GetMapId() != 1 ||
+            player->GetDistance2d(5737.0f, -3320.0f) > 55.0f)
+            return false;
+
+        // The archive retains Emerald Flameweaver's SmartAI and authored
+        // flight path, but no horn spell-to-summon link. Summoning it at the
+        // first waypoint lets the preserved path award its own quest credit.
+        if (!player->FindNearestCreature(40856, 100.0f, true))
+            player->SummonCreature(40856, 5730.93f, -3353.08f, 1612.75f, 0.0f,
+                TEMPSUMMON_TIMED_DESPAWN, 60000);
+
+        return true;
+    }
+};
