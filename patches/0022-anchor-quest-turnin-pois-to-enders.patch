+            int32 MapID = fields[1].GetInt32();
+            int32 X = fields[2].GetInt32();
+            int32 Y = fields[3].GetInt32();
+
+            questEnderPoints[QuestID].push_back({ MapID, QuestPOIPoint(X, Y) });
+        } while (enderPoints->NextRow());
+    }
