+    std::unordered_map<int32, std::vector<QuestEnderPoint>> questEnderPoints;
+    QueryResult enderPoints = WorldDatabase.Query(
+        "SELECT quest, map, ROUND(position_x), ROUND(position_y) FROM ("
+        "SELECT qe.quest, c.map, c.position_x, c.position_y "
+        "FROM creature_questender qe INNER JOIN creature c ON c.id = qe.id "
+        "UNION ALL "
+        "SELECT qe.quest, g.map, g.position_x, g.position_y "
