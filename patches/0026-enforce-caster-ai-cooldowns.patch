diff --git a/src/server/game/AI/CoreAI/CombatAI.cpp b/src/server/game/AI/CoreAI/CombatAI.cpp
--- a/src/server/game/AI/CoreAI/CombatAI.cpp
+++ b/src/server/game/AI/CoreAI/CombatAI.cpp
@@ -382,6 +382,22 @@ void CombatAI::UpdateAI(uint32 diff)
         DoMeleeAttackIfReady();
 }
-
+
+namespace
+{
+    uint32 GetCasterAISpellCooldown(uint32 spellId)
+    {
+        AISpellInfoType const* spell = GetAISpellInfo(spellId);
+
+        // Many imported Legion creature spells have no DB2 recovery time.
+        // Preserve real cooldowns, but use the AI category cooldown (including
+        // its control/damage safeguards) when the client data supplies none.
+        if (spell->realCooldown >= spell->cooldown)
+            return spell->realCooldown;
+
+        return spell->cooldown + urand(0, spell->cooldown);
+    }
+}
+
