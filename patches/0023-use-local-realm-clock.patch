+uint32 WowTime::EncodeLocal(time_t time)
+{
+    tm timeInfo{};
+
+#if (defined(WIN32) || defined(_WIN32) || defined(__WIN32__))
+    localtime_s(&timeInfo, &time);
+#else
+    localtime_r(&time, &timeInfo);
+#endif
+
+    WowTime wTime;
+    wTime.Year = timeInfo.tm_year - 100;
+    wTime.Month = timeInfo.tm_mon;
+    wTime.MonthDay = timeInfo.tm_mday - 1;
+    wTime.Hour = timeInfo.tm_hour;
+    wTime.Minute = timeInfo.tm_min;
+    wTime.WeekDay = timeInfo.tm_wday;
+
+    return wTime.Encode();
+}
