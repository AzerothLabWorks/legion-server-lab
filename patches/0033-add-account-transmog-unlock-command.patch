+    static bool HandleAccountUnlockTransmogsCommand(ChatHandler* handler, char const* args)
+    {
+        Player* player = handler->GetSession() ? handler->GetSession()->GetPlayer() : nullptr;
+        if (!player)
+            return false;
+
+        bool preview = false;
+        if (*args)
+        {
+            std::string option(args);
+            if (option != "preview")
+            {
+                handler->SendSysMessage("Usage: .account unlocktransmogs [preview]");
+                handler->SetSentErrorMessage(true);
+                return false;
+            }
+
+            preview = true;
+        }
+
+        if (!preview && player->isInCombat())
+        {
+            handler->SendSysMessage("Leave combat before unlocking the account transmog collection.");
+            handler->SetSentErrorMessage(true);
+            return false;
+        }
+
+        CollectionMgr* collection = player->GetCollectionMgr();
+        std::vector<uint32> additions;
+        uint32 scanned = 0;
+        uint32 eligible = 0;
+
+        for (ItemModifiedAppearanceEntry const* appearance : sItemModifiedAppearanceStore)
+        {
+            ++scanned;
+            if (!IsUnlockableTransmogAppearance(appearance))
+                continue;
+
+            ++eligible;
+            if (!collection->HasTransmog(appearance->ID))
+                additions.push_back(appearance->ID);
+        }
+
+        if (preview)
+        {
+            handler->PSendSysMessage("Transmog preview: %u build-matched armor and weapon appearances are eligible; %u are not yet unlocked (scanned %u DB2 records).",
+                eligible, uint32(additions.size()), scanned);
+            return true;
+        }
+
+        if (additions.empty())
+        {
+            handler->PSendSysMessage("Your account already has all %u eligible build-matched armor and weapon appearances.", eligible);
+            return true;
+        }
+
+        uint32 accountId = handler->GetSession()->GetAccountId();
+        uint32 characterGuid = player->GetGUIDLow();
+
+        CharacterDatabase.DirectPExecute(
+            "INSERT IGNORE INTO `azerothlab_account_transmogs_before_unlock` "
+            "SELECT * FROM `account_transmogs` WHERE `account` = %u",
+            accountId);
+
+        constexpr std::size_t BatchSize = 500;
+        for (std::size_t offset = 0; offset < additions.size(); offset += BatchSize)
+        {
+            std::size_t end = std::min(offset + BatchSize, additions.size());
+            std::ostringstream statement;
+            statement << "INSERT IGNORE INTO `account_transmogs` (`account`, `guid`, `ModelID`, `Condition`) VALUES ";
+
+            for (std::size_t index = offset; index < end; ++index)
+            {
+                if (index != offset)
+                    statement << ',';
+                statement << '(' << accountId << ',' << characterGuid << ',' << additions[index] << ",0)";
+            }
+
+            CharacterDatabase.DirectExecute(statement.str().c_str());
+        }
+
+        for (uint32 appearanceId : additions)
+            collection->AddTransmog(appearanceId, 0, false, false);
+
+        CharacterDatabase.DirectPExecute(
+            "INSERT INTO `azerothlab_account_transmog_unlock_log` "
+            "(`account`, `guid`, `scanned`, `eligible`, `added`) VALUES (%u, %u, %u, %u, %u)",
+            accountId, characterGuid, scanned, eligible, uint32(additions.size()));
+
+        handler->PSendSysMessage("Unlocked %u new build-matched armor and weapon appearances account-wide (%u eligible; %u DB2 records scanned).",
+            uint32(additions.size()), eligible, scanned);
+        handler->SendSysMessage("The operation is saved. Reopen Collections or relog if the appearance journal does not refresh immediately.");
+        return true;
+    }
