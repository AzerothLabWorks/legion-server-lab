+# LEVEL-1 STARTUP QUALITY OF LIFE
+#
+# Grants missing rewards on login at StartupQoL.Level and above.
+# The operation is idempotent: spells/pets are not duplicated, bags are topped up
+# to four, and money is raised to (but never reduced from) 20,000 gold.
+
+StartupQoL.Enable = 0
+StartupQoL.Level = 1
+StartupQoL.Riding = 1
+StartupQoL.Mounts = 1
+StartupQoL.Money = 1
+StartupQoL.Bags = 1
+StartupQoL.MagmaRageling = 1
