+namespace
+{
+    bool IsOffensiveRangedSpell(uint32 spellId)
+    {
+        SpellInfo const* spellInfo = sSpellMgr->GetSpellInfo(spellId);
+        if (!spellInfo || spellInfo->IsPassive() || spellInfo->IsPositive())
+            return false;
+
+        if (spellInfo->GetMaxRange(false) <= MELEE_RANGE)
+            return false;
+
+        return spellInfo->IsDamageSpell() || spellInfo->IsControlSpell()
+            || spellInfo->HasAura(SPELL_AURA_PERIODIC_DAMAGE)
+            || spellInfo->HasAura(SPELL_AURA_PERIODIC_DAMAGE_PERCENT)
+            || spellInfo->HasAura(SPELL_AURA_PERIODIC_LEECH);
+    }
+
+    bool HasOffensiveRangedSpell(Creature const* creature)
+    {
+        for (uint32 spellId : creature->m_templateSpells)
+            if (IsOffensiveRangedSpell(spellId))
+                return true;
+
+        if (creature->CreatureSpells)
+            for (CreatureSpellList::value_type const& spell : *creature->CreatureSpells)
+                if (IsOffensiveRangedSpell(spell.second.SpellID))
+                    return true;
+
+        return false;
+    }
+
+    bool ShouldUseCasterFallback(Creature const* creature, std::string const& aiName)
+    {
+        if (!sWorld->getBoolConfig(CONFIG_CREATURE_CASTER_AI_FALLBACK)
+            || creature->isCivilian() || creature->IsNeutralToAll() || creature->isWorldBoss())
+            return false;
+
+        if (!aiName.empty() && aiName != "SmartAI")
+            return false;
+
+        if (aiName == "SmartAI")
+        {
+            if (sSmartScriptMgr->HasScript(static_cast<int32>(creature->GetEntry()), SMART_SCRIPT_TYPE_CREATURE))
+                return false;
+
+            uint64 spawnId = creature->GetDBTableGUIDLow();
+            if (spawnId && sSmartScriptMgr->HasScript(-static_cast<int32>(spawnId), SMART_SCRIPT_TYPE_CREATURE))
+                return false;
+        }
+
+        return HasOffensiveRangedSpell(creature);
+    }
+}
