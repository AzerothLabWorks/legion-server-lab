+# COMPANION AUTO-LOOT
+#
+# Automatically loots one nearby eligible creature corpse per interval while
+# the player has an active non-combat companion. Group roll/master-loot rules
+# remain enforced by the normal loot handlers. Chests, skinning, pickpocketing,
+# gathering nodes, and item-created loot are excluded.
+
+CompanionAutoLoot.Enable = 0
+CompanionAutoLoot.Radius = 30
+CompanionAutoLoot.IntervalMs = 1500
+CompanionAutoLoot.OutOfCombatOnly = 1
+CompanionAutoLoot.RequireNonCombatCompanion = 1
