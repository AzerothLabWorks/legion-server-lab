         if (unit.IsPlayer() && unit.IsInWorld())
             unit.UpdatePosition(i_x, i_y, i_z, unit.GetOrientation(), false);
 
+    // Feral Lunge uses a parabolic jump, so its landing point is calculated at
+    // launch while the target is still free to move. Reacquire the target at
+    // touchdown and make a small, collision-aware correction to its current
+    // melee contact point. This preserves the jump while preventing the caster
+    // from sailing past an advancing target and finishing with it behind them.
+    if (m_Id == 196884 && m_targetGuid && unit.IsPlayer() && unit.IsInWorld() && !unit.GetTransport())
+    {
+        if (Unit* target = ObjectAccessor::GetUnit(unit, m_targetGuid))
+        {
+            if (target != &unit && target->isAlive() && target->IsInWorld() && !target->GetTransport() && unit.IsInMap(target))
+            {
+                float x, y, z;
+                target->GetContactPoint(&unit, x, y, z);
+
+                // Normal target movement during the jump is only a few yards.
+                // Do not follow teleports, knockbacks, or targets crossing
+                // geometry after the spell was launched.
+                constexpr float MaxLandingCorrection = 8.0f;
+                if (unit.GetExactDist2d(x, y) <= MaxLandingCorrection &&
+                    std::fabs(unit.GetPositionZ() - z) <= 3.0f && unit.IsWithinLOS(x, y, z))
+                    unit.UpdatePosition(x, y, z, unit.GetAngle(target), false);
+
+                unit.SetFacingTo(target);
+            }
+        }
+    }
+
     // Effect event. Used for delay cast after jump for example
     if (m_event)
     {
